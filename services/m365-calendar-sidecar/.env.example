# Microsoft 365 Calendar sidecar configuration
#
# Copy this file to `.env.calendar` and fill in the values for your tenant.
# The container reads these through docker-compose2 env interpolation.

# Azure AD / Microsoft Entra app registration client ID.
# Leave empty to use the bundled multi-tenant app registration.
# Override only if your tenant blocks the bundled client or you want to
# use a different registration.
M365_CALENDAR_CLIENT_ID=

# Tenant identifier. "common" lets personal + work/school accounts sign in.
# Use your tenant id (GUID) or a verified domain for single-tenant flows.
M365_CALENDAR_TENANT=common

# Host path bound to /var/lib/m365-calendar inside the container.
# The container must own this directory (chown 1000:1000).
M365_CALENDAR_STATE_DIR=./calendar-state

# Sidecar HTTP port exposed inside the docker network.
PORT=3000
