# planner-sidecar operator placeholders.
#
# Provision secrets through your secret manager (NOT via this file). The sidecar
# reads them from the process environment at runtime. Tokens MUST NEVER live
# in the repo, in Compose, in `state/openclaw.json`, in the workspace, in the
# Gateway, on the CLI, or in Engram.

# Optional. Override the built-in multi-tenant public client registration.
# PLANNER_CLIENT_ID=

# Optional. Defaults to 'common'. Use a tenant ID for a custom single-tenant app.
# PLANNER_TENANT=common

# Optional. Defaults to './planner-state'.
# PLANNER_STATE_DIR=./planner-state

# Optional. Effective profile in Fase 1. The Fase 1 hook accepts `profile?`
# on every tool but always resolves to this value.
# PLANNER_DEFAULT_PROFILE=default

# Optional. Sidecar HTTP port. Defaults to 3000.
# PORT=3000
